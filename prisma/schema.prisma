generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int                  @id @default(autoincrement())
  username                String               @unique
  nickanme                String?
  email                   String               @unique
  password_hash           String
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  lastSeen                DateTime?
  avatar                  String               @default("")
  publicKey               String?
  keyBackupEncrypted      String?
  keyBackupNonce          String?
  keyBackupSalt           String?
  keyBackupOpsLimit       Int?
  keyBackupMemLimit       Int?
  keyBackupAlg            Int?
  conversationMembers     ConversationMember[]
  messages                Message[]
  reactions               MessageReaction[]
  passwordResetTokens     PasswordResetToken[]
  conversationsCreated    Conversation[]
  keyCreatedConversations Conversation[]       @relation("KeyCreator")
  messageReads            MessageRead[]
  pinnedMessages          PinnedMessage[]
  userBlocksMade          UserBlock[]          @relation("BlocksMade")
  userBlocksReceived      UserBlock[]          @relation("BlocksReceived")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id             Int                  @id @default(autoincrement())
  createdAt      DateTime             @default(now())
  createdById    Int
  name           String?
  /**
   * The member who generated and sealed the shared conversation key. This is
   * NOT always the conversation creator: the first device to open the chat
   * generates the key. Every device decrypts the per-member key copy using
   * THIS user's public key (falling back to createdById for legacy rows),
   * because all copies are sealed with this user's private key.
   */
  keyCreatedById Int?
  creator        User                 @relation(fields: [createdById], references: [id])
  keyCreator     User?                @relation("KeyCreator", fields: [keyCreatedById], references: [id])
  members        ConversationMember[]
  messages       Message[]
  messageReads   MessageRead[]
  pinnedMessages PinnedMessage[]
}

model ConversationMember {
  id                       Int          @id @default(autoincrement())
  conversationId           Int
  userId                   Int
  encryptedConversationKey String?
  nonce                    String?
  clearedAt                DateTime?
  conversation             Conversation @relation(fields: [conversationId], references: [id])
  user                     User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id    Int     @id @default(autoincrement())
  text  String  @default("")
  nonce String?

  conversationId Int
  senderId       Int

  sentAt   DateTime  @default(now())
  editedAt DateTime?

  // Reply relationship
  replyToId Int?
  replyTo   Message?  @relation("MsgReply", fields: [replyToId], references: [id])
  repliedBy Message[] @relation("MsgReply")

  // Forwarding
  forwardedFromMsgId Int?

  // Relations
  reactions      MessageReaction[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  user           User              @relation(fields: [senderId], references: [id])
  attachment     Attachment?
  messageReads   MessageRead[]
  pinnedMessages PinnedMessage[]

  @@index([conversationId, sentAt])
}

model PinnedMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  messageId      Int
  pinnedById     Int
  pinnedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id])
  pinnedBy     User         @relation(fields: [pinnedById], references: [id])

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

model MessageReaction {
  id Int @id @default(autoincrement())

  messageId Int
  userId    Int
  emoji     String

  message Message @relation(fields: [messageId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model MessageRead {
  id             Int      @id @default(autoincrement())
  messageId      Int
  userId         Int
  conversationId Int
  readAt         DateTime

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Attachment {
  id        Int     @id() @default(autoincrement())
  messageId Int     @unique
  filePath  String
  mimeType  String
  fileSize  Int
  nonce     String?
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
